{
  "name": "lnmiit-event-management-system",
  "version": "2.0.0",
  "description": "LNMIIT Event Hub: a full-stack MERN system for scheduling, registering for and administering technical events",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed",
    "build": "cd frontend && npm run build",
    "test": "cd backend && npm test",
    "test:coverage": "cd backend && npm run test:coverage",
    "lint": "cd frontend && npm run lint"
  },
  "keywords": [
    "lnmiit",
    "events",
    "hackathon",
    "mern",
    "express",
    "react",
    "jest",
    "supertest"
  ],
  "author": "Adarsh Dwivedi",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
