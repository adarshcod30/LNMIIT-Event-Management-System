# ========================================
# LNMIIT Event Management System - Backend
# ========================================

# Server Configuration
# 5001, not 5000: on macOS, AirPlay Receiver already listens on 5000
PORT=5001
NODE_ENV=development
# Set to the number of reverse proxies in front of the API (1 on Render, Heroku,
# Railway, behind nginx or Caddy) so rate limits see the real client IP
# TRUST_PROXY=1
# Log level: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=info

# MongoDB Connection
# Replace with your MongoDB Atlas URI or local MongoDB URI
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.example.mongodb.net/lnmiit_events?retryWrites=true&w=majority

# Secrets. In production the server refuses to start unless both are set, are at
# least 32 characters, and are different from each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Outside production a missing secret is replaced by a random one per process.
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Admin account
# The first server start creates admin@lnmiit.ac.in with this password and forces
# a change on first login. Leave it empty to have a random one generated and
# printed once in the server log. There is no default password.
ADMIN_INITIAL_PASSWORD=

# Demo login: signs in as any seeded user (never the admin) with no password.
# Local development only. It is ignored when NODE_ENV=production.
ENABLE_DEMO_LOGIN=true

# Google OAuth 2.0
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Frontend URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Email Configuration (for notifications)
# Use Gmail SMTP or any other provider
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
